APP_NAME=OgarnijKod
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://twoja-domena.pl

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=nazwa_bazy_z_panelu_cba
DB_USERNAME=uzytkownik_bazy_z_panelu_cba
DB_PASSWORD=haslo_bazy_z_panelu_cba

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
# na hostingu współdzielonym nie ma workera kolejek, więc zadania wykonują się od razu
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="kontakt@twoja-domena.pl"
MAIL_FROM_NAME="${APP_NAME}"
