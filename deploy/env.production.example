APP_NAME=OgarnijKod
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://twoja-domena.pl

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=nazwa_bazy_z_panelu_cba
DB_USERNAME=uzytkownik_bazy_z_panelu_cba
DB_PASSWORD=haslo_bazy_z_panelu_cba

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
# na hostingu współdzielonym nie ma workera kolejek, więc zadania wykonują się od razu
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Wysyłka maili przez SMTP skrzynki na hostingu (panel cba.pl -> Poczta).
# Bez tego (MAIL_MAILER=log) maile trafiają tylko do storage/logs/laravel.log.
MAIL_MAILER=smtp
MAIL_HOST=mail.cba.pl
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME="kontakt@twoja-domena.pl"
MAIL_PASSWORD="haslo-do-skrzynki"
MAIL_FROM_ADDRESS="kontakt@twoja-domena.pl"
MAIL_FROM_NAME="${APP_NAME}"

# Gdzie mają przychodzić powiadomienia o nowych zgłoszeniach (puste = wyłączone)
MAIL_NOTIFY_TO="lukasz.bis22@gmail.com"
